{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{agenda.db,**/*.db,.env,.venv/**,venv/**}"
    }
  },
  "env": {
    "PYTHON_VERSION": "3.12"
  }
}
