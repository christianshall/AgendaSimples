# Copie para .env e preencha (desenvolvimento local)

# --- Banco de dados ---
# Local: deixe DATABASE_URL vazio → usa agenda.db na raiz do projeto
# Produção (Vercel/Turso): obrigatório
DATABASE_URL=libsql://seu-db-nome-seu-user.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Aliases aceitos pelo database.py:
# TURSO_DATABASE_URL (mesmo valor que DATABASE_URL)
# DATABASE_AUTH_TOKEN ou LIBSQL_AUTH_TOKEN (mesmo valor que TURSO_AUTH_TOKEN)
# SQLITE_DATABASE_PATH=caminho/opcional/agenda.db

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

TRIAL_DAYS=7
APP_BASE_URL=http://localhost:5000

# --- SMTP (recuperação de senha) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@seudominio.com
SMTP_USE_TLS=true
