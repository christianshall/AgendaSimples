# Copie para .env e preencha (desenvolvimento local)

# --- Banco de dados ---
# Produção (Vercel/Turso): obrigatório
TURSO_DATABASE_URL=libsql://seu-db-nome-seu-user.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Local SQL Server (desenvolvimento): USE_SQL_SERVER=1
USE_SQL_SERVER=1
SQL_SERVER_ODBC=Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=AgendaSimples;Trusted_Connection=yes;
# Local SQLite (sem Turso e sem SQL Server): deixe USE_SQL_SERVER vazio
# SQLITE_DATABASE_PATH=caminho/opcional/database.db

# --- Segurança (obrigatório em produção na Vercel) ---
SECRET_KEY=gere-uma-chave-longa-e-aleatoria-aqui

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

TRIAL_DAYS=7
PLANO_MENSAL_VALOR=49.90
APP_BASE_URL=http://localhost:5000

# --- SMTP (recuperação de senha) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@seudominio.com
SMTP_USE_TLS=true
