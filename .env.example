# Copie para .env e preencha com suas chaves do Stripe (modo teste primeiro)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Dias de trial gratuito no cadastro (banco local + alinhado ao Checkout)
TRIAL_DAYS=7

# URL pública do app (Stripe redireciona success/cancel para aqui)
APP_BASE_URL=http://localhost:5000

# SMTP — envio do link "Esqueci minha senha" (opcional em desenvolvimento)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@seudominio.com
SMTP_USE_TLS=true
